{
  "name": "pos-bakso-umum",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty",
    "build": "tsc -b && vite build && node scripts/generate-sw.mjs",
    "preview": "vite preview",
    "android:add": "npm run build && cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "qa": "node scripts/qa.mjs",
    "test:domain": "node --experimental-strip-types --test tests/*.test.ts",
    "test:firebase": "node scripts/verify-firebase-rbac.mjs",
    "bridge": "node bridge/server.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "firebase": "13.0.0",
    "qrcode": "^1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  }
}
